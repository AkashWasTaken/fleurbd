rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128; }

    // Products
    match /products/{productId} {
      function isValidProduct(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
               data.price is number && data.price >= 0 &&
               data.category is string &&
               data.slug is string && data.slug.size() > 0;
      }
      
      allow read: if true; // Public access for browsing
      allow create: if isValidProduct(incoming());
      allow update: if isValidProduct(incoming());
      allow delete: if true; // Temporary for admin dashboard
    }

    // Orders
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.orderNumber is string &&
               data.customer is map &&
               data.items is list &&
               data.total is number &&
               data.status in ['pending', 'confirmed', 'processing', 'shipped', 'delivered', 'cancelled'];
      }
      
      allow read: if true; // Dashboard needs access
      allow create: if isValidOrder(incoming()) && incoming().status == 'pending';
      allow update: if isValidOrder(incoming());
      allow delete: if true;
    }

    // Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if true; // Admin management
    }

    // Config - Password verification
    match /config/security {
      allow get: if true; // Client needs to fetch to verify login
      allow create: if !exists(/databases/$(database)/documents/config/security); // First time setup
      allow update: if true; // Admin changing password
    }
  }
}
